# ---------------------------------------------------------------------------
# Sridira Lake Creek — copy to .env.local and fill in before launch.
# ---------------------------------------------------------------------------

# --- Lead delivery (server-side, never exposed to the browser) --------------

# PLACEHOLDER — the "Inbound Webhook" trigger URL from your GoHighLevel workflow.
# Looks like: https://services.leadconnectorhq.com/hooks/<locationId>/webhook-trigger/<id>
# If unset, the API route logs a warning and falls through to the channels below.
GHL_WEBHOOK_URL=

# Fallback #1 — email the lead if the GHL webhook fails.
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=sales@example.com
LEAD_FROM_EMAIL="Sridira Lake Creek <onboarding@resend.dev>"

# --- Google Sheets lead tracking -------------------------------------------
# Every lead is appended to the "website leads" tab. Two ways in — pick one.
#
# (A) Service account — recommended, no public endpoint. Create a service
#     account in Google Cloud, enable the Sheets API, download the JSON key,
#     then SHARE THE SHEET with the service-account email as an Editor.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the whole private_key value including the BEGIN/END lines, in quotes.
# Literal 
 sequences are handled for you.
GOOGLE_PRIVATE_KEY=
#
# (B) Apps Script web app — quicker to set up. See the README for the script,
#     then paste the deployed /exec URL here instead of the two vars above.
GOOGLE_SHEETS_WEBHOOK_URL=
#
# Defaults already point at the project sheet and tab; override only to move it.
GOOGLE_SHEETS_ID=1-1oUBpa2dZDwpzBxK5ZF7z8dcKPgD0hL8xN15gO3jVk
GOOGLE_SHEETS_TAB=website leads

# --- Supabase (durable lead storage) ---------------------------------------
# SUPABASE_URL is injected automatically by the Vercel Supabase integration.
# The service-role key is server-only — it bypasses row-level security, so it
# must never be prefixed NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_LEADS_TABLE=leads

# Final fallback: leads are appended to ./leads.json. Disabled in production
# because serverless filesystems are ephemeral — set LEAD_FILE_SINK=1 to force.
LEAD_FILE_SINK=

# Any random string. Enables GET /api/lead/health?token=… which live-checks
# every sink and explains what is wrong. With this unset the route 404s.
LEAD_HEALTH_TOKEN=

# --- Analytics -------------------------------------------------------------
# Both are optional. If unset, no third-party script is loaded at all.
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GA_ID=

# --- Contact details shown on the site -------------------------------------
# Defaults are the real details from the back page of the digital brochure.
# Override here to route a campaign to a different tracking number.
NEXT_PUBLIC_CONTACT_PHONE=+917411995037
NEXT_PUBLIC_CONTACT_PHONE_DISPLAY=+91 74119 95037
NEXT_PUBLIC_CONTACT_EMAIL=info@sridiralakecreek.in
NEXT_PUBLIC_SITE_URL=https://www.sdlakecreek.online

# --- Compliance ------------------------------------------------------------
# TODO(launch): Karnataka RERA registration is legally required before
# advertising or selling an under-construction project in Bengaluru.
NEXT_PUBLIC_RERA_NUMBER=RERA No: [TO BE CONFIRMED]

# Hours quoted in the post-submit thank-you state.
NEXT_PUBLIC_CALLBACK_HOURS=24

# The brochure ships in /public/brochure and downloads on successful submit.
# Only set this to serve it from a CDN instead.
NEXT_PUBLIC_BROCHURE_URL=

# WhatsApp number for the floating button (digits only, with country code).
NEXT_PUBLIC_WHATSAPP_NUMBER=917411995037

# --- Static export only ----------------------------------------------------
# When building with NEXT_STATIC_EXPORT=1 there is no /api/lead, so point the
# form at an external collector (e.g. the GHL webhook or a serverless function).
NEXT_PUBLIC_LEAD_ENDPOINT=
